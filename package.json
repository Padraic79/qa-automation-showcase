{
  "name": "qa-automation-showcase",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --debug",
    "test:api": "newman run tests/api/collections/user-management.postman_collection.json -e tests/api/environments/dev.postman_environment.json --reporters cli,junit --reporter-junit-export reports/api-results.xml",
    "test:all": "npm run test:ui && npm run test:api",
    "report:ui": "playwright show-report reports/playwright-html",
    "allure:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "allure:serve": "allure serve reports/allure-results",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.3.3",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.1",
    "eslint": "^9.33.0",
    "faker": "^6.6.6",
    "newman": "^6.2.1",
    "playwright": "^1.55.0",
    "typescript": "^5.9.2"
  }
}
